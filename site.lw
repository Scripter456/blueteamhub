lw 1
site "Northgate Hub"
owner ed25519:REPLACE_WITH_OWNER_PUBLIC_KEY

gate challenge /auth/challenge
gate verify /auth/verify
onfail script /js/logout.js

channel general /api/general
channel advisories /api/advisories

script frontend /static/app.js
endpoint backend /api

peer lw://node2.example.org:8443

sig ed25519:REPLACE_WITH_SIGNATURE
